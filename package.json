{
  "name": "opencode-openspec-task-tui",
  "version": "0.0.0-development",
  "description": "OpenCode TUI sidebar for active OpenSpec task progress",
  "repository": {
    "type": "git",
    "url": "https://github.com/Angel-M-R/opencode-openspec-task-tui"
  },
  "homepage": "https://github.com/Angel-M-R/opencode-openspec-task-tui#readme",
  "bugs": {
    "url": "https://github.com/Angel-M-R/opencode-openspec-task-tui/issues"
  },
  "keywords": [
    "opencode",
    "openspec",
    "plugin",
    "tui",
    "statusline",
    "tasks"
  ],
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "pack:dry-run": "npm pack --dry-run",
    "release": "semantic-release",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "prepare": "husky",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:tui": "pnpm run build && bun test --preload ./test/helpers/opentui-solid-runtime.ts test/integration/tui.test.ts --test-name-pattern \"renders the full truncated task description after a real mouse move\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.50 <2",
    "@opentui/core": ">=0.4.0 <0.5",
    "@opentui/solid": ">=0.4.0 <0.5",
    "solid-js": ">=1.9.12 <2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@opencode-ai/plugin": "1.18.4",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "22.19.19",
    "esbuild-plugin-solid": "0.6.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8",
    "solid-js": "1.9.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
